rules_version = '2';

// =============================================================================
// TRANSITIONAL RULES (deploy now).
//
// Every access requires an authenticated user (much better than `if true`),
// but collections are not yet locked down per-document. This keeps the current
// flat-schema game working while the platform shell (Faz 1) is built.
//
// The full strict target ruleset (per-seat ownership, host-only phase, secret
// role docs) lives in `docs/firestore.rules.target` and replaces this file at
// Faz 1 deploy time.
//
// Deploy:  firebase deploy --only firestore:rules
//   (or paste into Firebase Console > Firestore > Rules > Publish)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if isAuthed();
      allow write: if isAuthed();
    }

    // Recursive: covers the room doc AND its subcollections (e.g. matches/).
    match /rooms/{roomCode}/{document=**} {
      allow read, write: if isAuthed();
    }

    match /game_history/{docId} {
      allow read, write: if isAuthed();
    }

    // Legacy guest sessions (no longer written by the new auth flow).
    match /guests/{guestId} {
      allow read, write: if isAuthed();
    }
  }
}
